// 分岐に `!`（unless）を使う。
// `(i > last) ? () : {...}` と書くと真でも `:` が発火して無限再帰する (§8.3, §10)
(i fizzbuzz last
    (i > last) ! {
        ( ((i % 15) == 0) ? (1 <<< "FizzBuzz")
        : ( ((i % 3) == 0) ? (1 <<< "Fizz")
          : ( ((i % 5) == 0) ? (1 <<< "Buzz")
            : (1 <<< i)
            )
          )
        ) ;
        (1 <<< "\n") ;
        ((i + 1) fizzbuzz last)
    }
) ;

(1 fizzbuzz 20)
